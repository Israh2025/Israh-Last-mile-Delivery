---
// Improvement idea: get actual width as props, and auto-set height by correct aspect-ratio
---

<svg
    width="180"
    height="72"
    viewBox="0 0 260 104"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-labelledby="logoTitle"
    role="img"
>
    <title id="logoTitle">Israh last-mile delivery</title>
    <defs>
        <linearGradient id="bagGradient" x1="30" y1="10" x2="170" y2="120" gradientUnits="userSpaceOnUse">
            <stop stop-color="#C000F9" />
            <stop offset="1" stop-color="#0094FF" />
        </linearGradient>
        <linearGradient id="textGradient" x1="120" y1="28" x2="220" y2="88" gradientUnits="userSpaceOnUse">
            <stop stop-color="#C000F9" />
            <stop offset="1" stop-color="#1D9BFF" />
        </linearGradient>
        <linearGradient id="swooshGradient" x1="18" y1="32" x2="130" y2="120" gradientUnits="userSpaceOnUse">
            <stop stop-color="#230050" stop-opacity="0.95" />
            <stop offset="1" stop-color="#001735" stop-opacity="0.95" />
        </linearGradient>
        <filter id="shadow" x="0" y="0" width="160" height="120" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
            <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="#000" flood-opacity="0.25" />
        </filter>
    </defs>

    <g filter="url(#shadow)">
        <path
            d="M40 34c0-8.284 6.716-15 15-15h24c8.284 0 15 6.716 15 15v7h-12v-6.5c0-4.418-3.582-8-8-8h-14c-4.418 0-8 3.582-8 8V42H40v-8z"
            fill="url(#bagGradient)"
        />
        <rect x="32" y="34" width="92" height="70" rx="12" fill="url(#bagGradient)" />
        <path
            d="M45 101c18-24 41-39.5 70-45c14.8-2.9 26.6-2.3 37 2c2.8 1.1 5.2 2.5 7.8 4.4c2.6 2 5.2 4.6 8.7 8l-9.6 8.7c-8.4-9.3-18.3-12.4-30.3-11.2C107 69.2 83.1 83.1 63 109L45 101z"
            fill="url(#swooshGradient)"
        />
    </g>

    <g>
        <text x="140" y="48" font-family="'Inter', 'Segoe UI', system-ui, sans-serif" font-size="28" font-weight="700" fill="url(#textGradient)">
            ISRAH
        </text>
        <text
            x="140"
            y="80"
            font-family="'Amiri', 'Scheherazade', 'Noto Naskh Arabic', serif"
            font-size="30"
            font-weight="700"
            fill="#3BA1FF"
        >
            إسراع
        </text>
    </g>
</svg>
